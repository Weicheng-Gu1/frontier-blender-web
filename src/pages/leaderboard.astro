---
import Site from "../layouts/Site.astro";
import ResultsTable from "../components/ResultsTable.astro";
import results from "../data/results.json";
import {categories, labels, categoryLines, modelName, tokens, url} from "../lib/site";
import "../styles/leaderboard.css";

const rows=results.models.map(m=>({
  name:modelName(m), usd:m.usage.mean_cost_usd, tokens:tokens(m.usage.mean_tokens),
  family:m.model.startsWith("gpt")?"openai":m.model.startsWith("claude")?"claude":m.model.split("-")[0].split(/[0-9.]/)[0],
  scores:{overall:m.mean_total*100,...Object.fromEntries(categories.map(k=>[k,100*(m.domains as Record<string,{mean_total:number}>)[k].mean_total]))}
}));
const xMax=Math.ceil(Math.max(...rows.map(r=>r.usd))/10)*10;
const yMax=Math.ceil((Math.max(...rows.map(r=>r.scores.overall))+2)/10)*10;
const yMin=Math.max(0,Math.floor((Math.min(...rows.map(r=>r.scores.overall))-2)/10)*10);
const x=(usd:number)=>usd/xMax*100;
const y=(v:number)=>(v-yMin)/(yMax-yMin)*100;
let best=-Infinity;
const frontier=[...rows].sort((a,b)=>a.usd-b.usd||b.scores.overall-a.scores.overall).filter(r=>{
  if(r.scores.overall<=best)return false;
  best=r.scores.overall;return true;
});
const line=frontier.map((r,i)=>i?"H"+x(r.usd)+"V"+(100-y(r.scores.overall)):"M"+x(r.usd)+" "+(100-y(r.scores.overall))).join(" ")+"H100";
const ticks=Array.from({length:(yMax-yMin)/10+1},(_,i)=>yMin+10*i);
const first=rows[0];
---
<Site title="Leaderboard · AgentRecBench" active="Leaderboard" wide>
<div class="lb not-prose" data-rows={JSON.stringify(rows)}>
<header class="lb-intro"><div><h1>Leaderboard</h1><p>Compare reconstruction quality across 80 Blender tasks and the cost of producing each scene.</p></div></header>
<div class="lb-panels">
<section class="lb-card"><header><h2>Reconstruction score</h2><label class="lb-scope"><span data-scope-label aria-hidden="true">Overall</span><span class="sr-only">Rank models by category</span><select data-scope><option value="overall">Overall</option>{categories.map(k=><option value={k} data-lines={categoryLines[k]}>{labels[k]}</option>)}</select></label></header>
<p>Mean score out of 100</p>
<div class="lb-bars" style={"--count:"+rows.length}>{rows.map((r,i)=><button type="button" class="lb-row" data-row={i} style={"--rank:"+i+";--value:"+r.scores.overall+"%"} aria-pressed={i===0}>
<span class="lb-rank">{i+1}</span><span class="lb-model">{r.name}</span><span class="lb-track"><i></i></span><b>{r.scores.overall.toFixed(2)}</b></button>)}</div>
</section>
<section class="lb-card lb-cost"><header><h2>Performance vs. cost</h2></header><p>Overall score by mean cost per task</p>
<div class="lb-plotwrap"><div class="lb-plot">
{ticks.map(v=><div class="lb-y" style={"bottom:"+y(v)+"%"}><span>{v}</span></div>)}
{[0,1,2,3,4].map(i=><div class="lb-x" style={"left:"+i*25+"%"}><span>${xMax*i/4}</span></div>)}
<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path class="lb-fill" d={line+" V100 H"+x(frontier[0].usd)+" Z"}/><path class="lb-line" d={line}/></svg>
{rows.map((r,i)=><button class="lb-dot" data-point={i} type="button" aria-pressed={i===0} aria-label={r.name+", "+r.scores.overall.toFixed(2)+" points, $"+r.usd.toFixed(2)+" per task"} style={"left:"+x(r.usd)+"%;bottom:"+y(r.scores.overall)+"%"}><img src={url("logos/"+r.family+".png")} alt=""/></button>)}
</div></div><div class="lb-units"><i></i>Best score within budget</div>
<div class="lb-detail" aria-live="polite"><strong data-name>{first.name}</strong><dl><div><dt>Overall</dt><dd data-overall>{first.scores.overall.toFixed(2)}</dd></div><div><dt>USD / task</dt><dd data-usd>${first.usd.toFixed(2)}</dd></div><div><dt>Tokens / task</dt><dd data-tokens>{first.tokens}</dd></div></dl></div>
</section></div>
<section class="lb-table"><h2>Full results</h2><p>{rows.length} configurations · 80 tasks per configuration · Six reconstruction scales</p><ResultsTable/></section>
</div></Site>
<script>
type Row={name:string;usd:number;tokens:string;scores:Record<string,number>};
const board=document.querySelector<HTMLElement>(".lb")!;
const rows:Row[]=JSON.parse(board.dataset.rows!);
const bars=Array.from(board.querySelectorAll<HTMLButtonElement>("[data-row]"));
const dots=Array.from(board.querySelectorAll<HTMLButtonElement>("[data-point]"));
const tableRows=Array.from(board.querySelectorAll<HTMLTableRowElement>("tbody tr"));
function select(i:number){
 const r=rows[i];
 bars.forEach((b,j)=>b.setAttribute("aria-pressed",String(j===i)));
 dots.forEach((b,j)=>b.setAttribute("aria-pressed",String(j===i)));
 tableRows.forEach((tr,j)=>tr.classList.toggle("lb-selected",j===i));
 board.querySelector("[data-name]")!.textContent=r.name;
 board.querySelector("[data-overall]")!.textContent=r.scores.overall.toFixed(2);
 board.querySelector("[data-usd]")!.textContent="$"+r.usd.toFixed(2);
 board.querySelector("[data-tokens]")!.textContent=r.tokens;
}
[...bars,...dots].forEach(b=>{
 const i=Number(b.dataset.row??b.dataset.point);
 for(const event of ["focus","click","pointerenter"])b.addEventListener(event,()=>select(i));
});
board.querySelector<HTMLSelectElement>("[data-scope]")!.addEventListener("change",e=>{
 const select=e.currentTarget as HTMLSelectElement;
 const key=select.value;
 board.querySelector("[data-scope-label]")!.textContent=select.selectedOptions[0].dataset.lines ?? "Overall";
 const ordered=rows.map((r,i)=>({i,value:r.scores[key]})).sort((a,b)=>b.value-a.value);
 ordered.forEach(({i,value},rank)=>{
  const b=bars[i];
  b.style.setProperty("--rank",String(rank));b.style.setProperty("--value",value+"%");
  b.querySelector(".lb-rank")!.textContent=String(rank+1);b.querySelector("b")!.textContent=value.toFixed(2);
  b.parentElement!.append(b);
 });
});
select(0);
</script>