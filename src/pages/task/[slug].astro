---
import html from "../../task-atlas/detail.html?raw";
import catalog from "../../../public/atlas/current-catalog.json";

export function getStaticPaths() {
  return catalog.cases.map(({ slug, title }) => ({
    params: { slug },
    props: { title },
  }));
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const escapedTitle = title.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
---
<Fragment set:html={html.replaceAll("__TASK_SITE_BASE__", base).replace("__TASK_PAGE_TITLE__", `${escapedTitle} · AgentRecBench`)} />
