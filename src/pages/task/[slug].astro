---
import Site from "../../layouts/Site.astro";
import tasks from "../../../public/tasks.json";
import results from "../../data/results.json";
import {url,labels,modelName,score} from "../../lib/site";
export function getStaticPaths(){return tasks.map(task=>({params:{slug:task.slug},props:{task}}))}
const {task}=Astro.props;
const rows=results.selected.filter(r=>r.slug===task.slug).sort((a,b)=>b.total-a.total);
---
<Site title={`${task.title} · AgentRecBench`} active="Task" wide><a class="back-link" href={url("task/")}>All tasks</a><p class="eyebrow">{labels[task.category]}</p><h1 class="task-title">{task.title}</h1><p class="page-intro">Reconstruct the original scene from its supplied reference information.</p><nav class="article-toc" aria-label="Task sections"><a href="#views">Multi-view images</a><a href="#drawings">Technical drawings</a><a href="#results">Results</a></nav><section id="views"><h2>Multi-view images</h2><div class="reference-grid not-prose">{task.public.map(v=><figure><a href={url(`task/${task.slug}/${v.image}`)} target="_blank" rel="noopener"><img src={url(`task/${task.slug}/${v.image}`)} alt={`${task.title}, reference ${v.id}`} loading="lazy" width="800" height="600"/></a><figcaption>{v.id}</figcaption><details><summary>Camera parameters</summary><pre>{JSON.stringify(v,null,2)}</pre></details></figure>)}</div></section><section id="drawings"><h2>Technical drawings</h2><div class="drawing-grid not-prose">{task.drawings.map(v=><figure><a href={url(`task/${task.slug}/${v.image}`)} target="_blank" rel="noopener"><img src={url(`task/${task.slug}/${v.image}`)} alt={`${task.title}, drawing ${v.id}`} loading="lazy"/></a><figcaption>{v.id} · Open to enlarge</figcaption></figure>)}</div></section><section id="results"><h2>Model results</h2><p>Paper snapshot · {results.date}. Per-task overall scores out of 100.</p><div class="table-scroll"><table class="task-result-table"><thead><tr><th>Model</th><th>Overall</th></tr></thead><tbody>{rows.map(r=><tr><th>{modelName(r)}</th><td>{score(r.total)}</td></tr>)}</tbody></table></div><a href={url("leaderboard/")}>Full leaderboard and scoring notes</a></section><p class="small-note">Images on this preview are compressed display copies. Original task assets and scoring renders are unchanged. The preview shows visual inputs and the dated result snapshot; full task instructions and production specifications remain in the task package.</p></Site>
