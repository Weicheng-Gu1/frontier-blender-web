---
import evidence from '../../public/data/blog-evidence-manifest.json';
import {url} from '../lib/site';
const cases=evidence.diagnostics.astra62_local_fidelity;
---
<section class="failure-examples not-prose" aria-label="Four error modes in GPT-6.2-Astra (high) reconstructions">
 {cases.map(c=><article>
  <header><h4>{c.mode}</h4><a href={url('task/'+c.slug+'/')}>{c.title}</a></header>
  <div class="failure-pair">
   {[[c.detailGT ?? c.gt,'Expert reference'],[c.detailPrediction ?? c.prediction,'GPT-6.2-Astra (high)']].map(([src,label])=><figure>
    <figcaption>{label}</figcaption><a href={url(src)}><img src={url(src)} alt={label+' · '+c.focus+(c.detailGT?' · H13 material-rendered detail':'')} width="520" height="390" loading="lazy"/></a>
   </figure>)}
  </div>
  <p>{c.description}</p>
  <div class="measurement"><span>{c.metricLabel}</span><strong>{c.value}</strong></div>
  <footer><a href={url(c.input)}><img src={url(c.input)} alt="" width="52" height="39" loading="lazy"/>Public input · {c.publicView}</a><span>{c.focus}</span></footer>
  {c.detailGT && <details><summary>View full H13 images</summary><div class="failure-pair">
   {[[c.gt,'Expert reference'],[c.prediction,'GPT-6.2-Astra (high)']].map(([src,label])=><figure><figcaption>{label}</figcaption><a href={url(src)}><img src={url(src)} alt={label+' · Florence H13, full RGB view'} width="520" height="390" loading="lazy"/></a></figure>)}
  </div></details>}
 </article>)}
</section>
<style>
.failure-examples{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(14px,2vw,24px)}
.failure-examples article{min-width:0;padding:clamp(14px,1.55vw,22px);border:1px solid var(--edge);border-radius:12px;background:var(--surface);color:var(--body)}
.failure-examples header{display:flex;align-items:baseline;justify-content:space-between;gap:4px 12px;flex-wrap:wrap}
.failure-examples h4{margin:0;color:var(--ink);font-size:1.06rem;line-height:1.3}.failure-examples header a,.failure-examples footer,.failure-examples summary{font-size:.79rem}
.failure-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}
.failure-pair figure{margin:0;min-width:0}.failure-pair figcaption{margin:0 0 4px;color:var(--muted-ink);font-size:.74rem}.failure-pair img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;background:var(--lilac);border-radius:6px;margin:0}
.failure-examples article>p{margin:12px 0;font-size:.9rem;line-height:1.5}
.measurement,.failure-examples footer{display:flex;align-items:center;justify-content:space-between;gap:8px}.measurement{border-block:1px solid var(--edge);padding:7px 0;font-size:.83rem}.measurement strong{color:var(--ink);font-variant-numeric:tabular-nums}
.failure-examples footer{margin-top:9px;flex-wrap:wrap;color:var(--muted-ink)}.failure-examples footer a{display:inline-flex;align-items:center;gap:6px}.failure-examples footer img{display:block;margin:0;border-radius:4px;object-fit:cover}
.failure-examples details{margin-top:10px}.failure-examples summary{cursor:pointer;color:var(--purple)}
@media(max-width:800px){.failure-examples{grid-template-columns:1fr}}
</style>
