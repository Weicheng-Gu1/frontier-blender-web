---
import results from "../data/results.json";
import {modelName,score,tokens,categories,labels,url} from "../lib/site";
const logo = (model:string) => model.startsWith("gpt") ? "openai" : model.startsWith("claude") ? "claude" : ["qwen","kimi","deepseek","glm"].find(b=>model.startsWith(b));
const domainScore = (m: typeof results.models[number], c: string) => score((m.domains as Record<string,{mean_total:number}>)[c].mean_total);
---
<div class="table-scroll not-prose" role="region" aria-label="Model leaderboard" tabindex="0"><table class="results-table"><thead><tr><th rowspan="2">Rank</th><th rowspan="2">Model</th><th rowspan="2">Overall</th><th rowspan="2">Avg. tokens</th><th rowspan="2">Avg. cost</th><th colspan="6" class="category-heading">Task categories</th></tr><tr>{categories.map(c=><th scope="col" data-category={c} aria-label={labels[c]}>{c==='object-arrangements'?<span class="stacked-category">{labels[c].split(' ').map(word=><span>{word}</span>)}</span>:labels[c]}</th>)}</tr></thead><tbody>{results.models.map((m,i)=><tr><td class="rank">{i+1}</td><th scope="row"><div class="model-cell"><img src={url(`logos/${logo(m.model)}.png`)} alt="" width="24" height="24"/><span>{modelName(m)}<small>80 / 80 tasks</small></span></div></th><td class="overall">{score(m.mean_total)}</td><td title={String(m.usage.mean_tokens)}>{tokens(m.usage.mean_tokens)}</td><td>${m.usage.mean_cost_usd.toFixed(2)}</td>{categories.map(c=><td data-category={c}>{domainScore(m,c)}</td>)}</tr>)}</tbody></table></div>

<style>
  .results-table [data-category="object-arrangements"] { text-align:center; }
  thead th { vertical-align: middle; }
  .stacked-category { display: grid; justify-items: center; text-align: center; line-height: 1.25; }
</style>
