---
import results from '../data/results.json';
import atlas from '../../public/atlas/current-catalog.json';
const bars = atlas.groups.map(({id:key,label,labelLines}) => {
  const domains = results.models.map(m => (m.domains as Record<string,{tasks:number;mean_total:number}>)[key]);
  return {name:label,lines:labelLines.join('\n'),count:domains[0].tasks,mean:domains.reduce((s,d)=>s+d.mean_total*100,0)/domains.length};
});
---
<figure class="category-means not-prose">
  <div class="category-scroll" role="region" aria-label="Reconstruction score by category" tabindex="0">
    <table aria-label="Mean reconstruction score by category" aria-describedby="category-means-caption">
      <thead><tr>{bars.map(b=><th scope="col"><span class="category-lines">{b.lines}</span><small>({b.count})</small></th>)}</tr></thead>
      <tbody><tr>{bars.map(b=><td><span class="category-track" aria-hidden="true"><i style={{height:b.mean+'%'}}></i></span><strong>{b.mean.toFixed(1)}</strong></td>)}</tr></tbody>
    </table>
  </div>
  <figcaption id="category-means-caption">Mean reconstruction score out of 100 across {results.models.length} configurations. Parentheses give the number of tasks in each current category.</figcaption>
</figure>
