---
import results from '../data/results.json';
import {categories,labels} from '../lib/site';
const bars = categories.map(key => {
  const domains = results.models.map(m => (m.domains as Record<string,{tasks:number;mean_total:number}>)[key]);
  return {name:labels[key],count:domains[0].tasks,mean:domains.reduce((s,d)=>s+d.mean_total*100,0)/domains.length};
});
---
<figure class="category-means not-prose">{bars.map(b=><div><span>{b.name} <small>({b.count})</small></span><div class="mean-track"><i style={'width:'+b.mean+'%'}></i></div><strong>{b.mean.toFixed(1)}</strong></div>)}<figcaption>Mean reconstruction score out of 100 across ten configurations. Parentheses give the number of tasks in each current category.</figcaption></figure>
